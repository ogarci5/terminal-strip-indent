<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.terminal-strip-indent"
          path="/org/gnome/shell/extensions/terminal-strip-indent/">
    <key name="bullet" type="s">
      <choices>
        <choice value="enabled"/>
        <choice value="disabled"/>
      </choices>
      <default>'enabled'</default>
      <summary>Treat a Claude Code reply bullet on the first line as its two spaces</summary>
    </key>
    <key name="terminals" type="as">
      <default>['org.gnome.Ptyxis', 'org.gnome.Ptyxis.Devel', 'org.gnome.Terminal', 'org.gnome.Console', 'kitty', 'Alacritty', 'org.wezfurlong.wezterm', 'com.mitchellh.ghostty', 'foot']</default>
      <summary>Window classes whose copies are rewritten</summary>
    </key>
  </schema>
</schemalist>
